{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-spawn/hooks/pre-teardown.json",
  "title": "pre-teardown hook payload (stdin)",
  "description": "Fired at teardown order step 3, after the live checks. Exit 13 escalates (exit 13), any other non-zero exit or a timeout vetoes (exit 11).",
  "type": "object",
  "properties": {
    "tool": {
      "const": "agent-spawn"
    },
    "hook": {
      "const": "pre-teardown"
    },
    "object_type": {
      "const": "agent"
    },
    "object_id": {
      "$ref": "../defs.json#/$defs/agent_id",
      "description": "The agent id."
    },
    "repo": {
      "oneOf": [
        {
          "$ref": "../defs.json#/$defs/repo_id"
        },
        {
          "type": "null"
        }
      ]
    },
    "labels": {
      "$ref": "../defs.json#/$defs/labels"
    },
    "kind": {
      "oneOf": [
        {
          "$ref": "../defs.json#/$defs/kind"
        },
        {
          "type": "null"
        }
      ],
      "description": "Launch kind."
    },
    "run_kind": {
      "oneOf": [
        {
          "$ref": "../defs.json#/$defs/kind"
        },
        {
          "type": "null"
        }
      ],
      "description": "The last run's kind; null before a run."
    },
    "reads_third_party": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "Of the last run; null before a run. When it or tainted is true, notification templates exclude report.summary and report.reason (also those of outcome objects)."
    },
    "tainted": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "The session's taint; null without a session. When it or reads_third_party is true, notification templates exclude report.summary and report.reason."
    },
    "mode": {
      "$ref": "../defs.json#/$defs/mode"
    },
    "status": {
      "$ref": "../defs.json#/$defs/status"
    },
    "needs_attention": {
      "$ref": "../defs.json#/$defs/needs_attention"
    },
    "event_id": {
      "type": "integer",
      "minimum": 1,
      "description": "agent-spawn's event id, unique per event across agents; delivery is at least once: deduplicate on it."
    },
    "ts": {
      "$ref": "../defs.json#/$defs/ts"
    },
    "agent": {
      "$ref": "../defs.json#/$defs/agent"
    },
    "merged_head": {
      "oneOf": [
        {
          "$ref": "../defs.json#/$defs/sha"
        },
        {
          "type": "null"
        }
      ]
    },
    "force": {
      "type": "boolean"
    },
    "actor": {
      "$ref": "../defs.json#/$defs/actor"
    },
    "decision_ids": {
      "$ref": "../defs.json#/$defs/decision_ids"
    },
    "override_escalation": {
      "type": "boolean"
    }
  },
  "additionalProperties": false,
  "required": [
    "tool",
    "hook",
    "object_type",
    "object_id",
    "repo",
    "labels",
    "kind",
    "run_kind",
    "reads_third_party",
    "tainted",
    "mode",
    "status",
    "needs_attention",
    "event_id",
    "ts",
    "agent",
    "merged_head",
    "force",
    "actor",
    "decision_ids",
    "override_escalation"
  ]
}
